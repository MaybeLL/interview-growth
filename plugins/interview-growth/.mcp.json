{
  "mcpServers": {
    "interview-growth": {
      "command": "uv",
      "args": [
        "run",
        "--no-editable",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "interview_growth.mcp_server"
      ],
      "env": {
        "INTERVIEW_GROWTH_DATA_DIR": "${CLAUDE_PLUGIN_DATA}",
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/src"
      }
    }
  }
}
